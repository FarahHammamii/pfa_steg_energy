# Example environment configuration for STEG Energy Lakehouse
# Copy to project root as .env or to config/.env

# Database
NEON_DATABASE_URL=postgresql://username:password@host:5432/database

# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# External APIs
WORLD_BANK_API=https://api.worldbank.org/v2
OPEN_METEO_API=https://archive-api.open-meteo.com/v1/archive

# Data paths
RAW_DATA_DIR=./data/raw

# Business config
PROSOL_REGIONS=bizerte
LOG_LEVEL=INFO

# API auth and notifications
JWT_SECRET_KEY=change-me-in-production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
